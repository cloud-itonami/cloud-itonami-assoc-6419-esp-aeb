(ns association-facts-test
  (:require [kotoba.bytes :as kbytes] [clojure.java.io :as io] [kotoba.process :as shell]
            [kotoba.test :refer [deftest is testing]]
            [kotoba.compiler.core :as compiler] [kotoba.kir :as ir]))
(def source (slurp "src/association_facts.kotoba"))
(defn call [kir f & xs] (ir/execute kir f (vec xs)))
(defn present [x] (when (second x) (nth x 2)))
(def fields ["id" "title" "association" "isic" "country" "kind" "url" "url-provenance"
             "established-date" "last-revised-date" "retrieved-at"])
(def expected
  [{"id" "aeb.founding-1977" "title" "AEB founding (Our history)"
    "association" "aeb" "isic" "6419" "country" "ESP" "kind" "governance-program"
    "url" "https://aebanca.es/en/about-aeb/our-history/"
    "url-provenance" "official-aebanca-es" "established-date" "1977" "last-revised-date" nil
    "retrieved-at" "2026-07-17"}
   {"id" "aeb.european-banking-federation-entry-1985"
    "title" "Spain's EU accession and AEB's entry into the European Banking Federation (Our history)"
    "association" "aeb" "isic" "6419" "country" "ESP" "kind" "governance-program"
    "url" "https://aebanca.es/en/about-aeb/our-history/"
    "url-provenance" "official-aebanca-es" "established-date" "1985" "last-revised-date" nil
    "retrieved-at" "2026-07-17"}])
(deftest reference-preserves-authority
  (let [kir (:kir (compiler/compile-source source :js-kotoba-v1))
        observed (mapv (fn [i] (into {} (map (fn [f] [f (present (call kir 'entry-field "aeb" i f))]) fields))) [0 1])]
    (is (= expected observed))
    (is (= ["1977" "1985"] (mapv #(present (call kir 'entry-field "aeb" % "established-date")) [0 1])))
    (is (= [nil nil] (mapv #(present (call kir 'entry-field "aeb" % "last-revised-date")) [0 1])))
    (is (= [["governance"] ["governance"]]
           (mapv (fn [i] (mapv #(present (call kir 'topic "aeb" i %)) (range (call kir 'topic-count "aeb" i)))) [0 1])))
    (is (= ["aeb.founding-1977" "aeb.european-banking-federation-entry-1985"]
           (mapv #(present (call kir 'by-topic-id "aeb" "governance" %)) [0 1])))
    (is (= #{} (set (:effects kir))))
    (testing "fail closed"
      (is (zero? (call kir 'entry-count "spanish-banking-association")))
      (is (zero? (call kir 'entry-count "bap")))
      (is (nil? (present (call kir 'entry-field "aeb" 2 "id"))))
      (is (nil? (present (call kir 'entry-field "aeb" 0 "last-revised-date"))))
      (is (nil? (present (call kir 'topic "aeb" 1 1))))
      (is (zero? (call kir 'by-topic-count "aeb" "labor")))
      (is (nil? (present (call kir 'by-topic-id "aeb" "governance" 2)))))))
(defn compiler-root [] (nth (iterate #(.getParent ^java.nio.file.Path %)
  (java.nio.file.Path/of (.toURI (io/resource "kotoba/compiler/core.clj")))) 4))
(defn base64 [x] (kbytes/base64-encode x))
(deftest restricted-js-and-wasm-conform-semantically
  (let [js (compiler/compile-source source :js-kotoba-v1) wasm (compiler/compile-source source :wasm32-browser-kotoba-v1)
        js64 (base64 (kbytes/utf8-bytes ^String (:source js))) wasm64 (base64 ^bytes (:bytes wasm))
        p (shell/sh "node" "--input-type=module" "-e"
            (str "import(process.argv[1]).then(async h=>{const j=await import('data:text/javascript;base64," js64 "');const w=await h.instantiateKotoba(Buffer.from(process.argv[2],'base64'));const r=x=>{if(x['entry-field']('aeb',0n,'established-date')[2]!=='1977'||x['entry-field']('aeb',1n,'established-date')[2]!=='1985'||x['entry-field']('aeb',0n,'last-revised-date')[1]!==false)throw Error('dates');if(x['by-topic-count']('aeb','governance')!==2n||x['by-topic-id']('aeb','governance',1n)[2]!=='aeb.european-banking-federation-entry-1985'||x['entry-count']('spanish-banking-association')!==0n||x['entry-count']('bap')!==0n)throw Error('authority');};r(j.instantiateKotoba({}));r(w.instance.exports)}).catch(e=>{console.error(e);process.exit(99)})")
            (.toString (.toUri (.resolve (compiler-root) "runtime/browser-host.mjs"))) wasm64)]
    (is (zero? (:exit p)) (str (:out p) (:err p)))))
(deftest production-source-authority
  (is (= ["src/association_facts.kotoba"] (->> (file-seq (io/file "src")) (filter #(.isFile %)) (map str) sort vec))))
